  "fieldConfig": {
    "version": 1,
    "fields": [
      {
        "nodeId": "92",
        "param": "filename_prefix",
        "label": "输出文件前缀",
        "description": "生成文件保存时使用的名称前缀，不影响画面内容。"
      },
      {
        "nodeId": "92",
        "param": "format",
        "label": "视频容器",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "115",
        "param": "aspect_ratio",
        "label": "画面比例",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "115",
        "param": "megapixels",
        "label": "画面像素量（百万）",
        "description": "默认 0.98，当前 16:9 比例输出 1344×768。"
      },
      {
        "nodeId": "115",
        "param": "multiple",
        "label": "尺寸对齐倍数",
        "description": "文本连线填写数字，提交时校验类型与范围。"
      },
      {
        "nodeId": "119",
        "param": "vae_name",
        "label": "视频 VAE 模型",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "120",
        "param": "vae_name",
        "label": "音频 VAE 模型",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "123",
        "param": "sampler_name",
        "label": "采样器",
        "description": "控制采样算法。没有明确需求时建议保留工作流默认值。"
      },
      {
        "nodeId": "124",
        "param": "scheduler",
        "label": "调度器",
        "description": "控制降噪过程的步长分布，通常与采样器配套使用；建议保留工作流默认值。"
      },
      {
        "nodeId": "124",
        "param": "denoise",
        "label": "去噪强度",
        "description": "越低越保留原图，越高越按提示词重绘。轻微调整可用 0.3–0.55，明显改色或改造可从 0.65–0.8 尝试；过高可能改变构图和主体。"
      },
      {
        "nodeId": "127",
        "param": "unet_name",
        "label": "视频模型",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "127",
        "param": "weight_dtype",
        "label": "模型精度",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "128",
        "param": "clip_name",
        "label": "文本编码模型",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "128",
        "param": "type",
        "label": "文本编码器类型",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "128",
        "param": "device",
        "label": "文本编码器设备",
        "description": "文本连线填写下拉选项的完整值。"
      },
      {
        "nodeId": "129",
        "param": "noise_seed",
        "label": "随机种子",
        "description": "默认 2609071842，为《重启天际》实测种子。"
      },
      {
        "nodeId": "130",
        "param": "fps",
        "label": "输出帧率",
        "description": "文本连线填写数字，提交时校验类型与范围。"
      },
      {
        "nodeId": "130",
        "param": "bit_depth",
        "label": "视频位深",
        "description": "文本连线填写数字，提交时校验类型与范围。"
      },
      {
        "nodeId": "131",
        "param": "expression",
        "label": "时长转帧数公式",
        "description": "可直接填写或连接文本节点。"
      },
      {
        "nodeId": "132",
        "param": "value",
        "label": "视频时长（秒）",
        "description": "默认 6 秒；模型按帧数规则对齐，实测输出约 6.58 秒。"
      },
      {
        "nodeId": "136",
        "param": "ref_image_size",
        "label": "参考图尺寸策略",
